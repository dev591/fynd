# Server-side only. Copy to .env (git-ignored) and fill in. Real environment variables always win over this file.

# --- Login (Supabase Auth). The API checks every token. ---
SUPABASE_URL=                 # https://<project>.supabase.co
SUPABASE_ANON_KEY=            # the public anon/publishable key. Never the service_role key
SUPABASE_JWT_SECRET=          # optional: verify HS256 logins locally (faster). Without it the API asks Supabase

# --- AI (all optional: every AI path falls back to the manual route) ---
OPENAI_API_KEY=
MODEL_FAST=                   # text understanding; read the name from your OpenAI dashboard (MODEL_INTAKE also works)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# --- Logistics (Delhivery LTL). Optional: without a token the seller types freight and lead time by hand ---
DELHIVERY_TOKEN=              # Bearer token from Delhivery. Server-side only
DELHIVERY_BASE_URL=           # default https://ltl-clients-api-dev.delhivery.com (the dev host)

# --- Behaviour ---
FREE_REVEALS=3                # free seller reveals per buyer, then the (mock) paywall
BALANCED_TOLERANCE=0.05       # "balanced" mode pays up to this much over the cheapest to arrive sooner. An assumption
DEMO_AUTOPILOT=on             # synthetic demo sellers answer by themselves. "off" to start with none
DEMO_WINDOW_MINUTES=          # e.g. 2 shortens every quote window for a demo (the UI says "demo timing")
ALLOW_DEMO_SELLERS=true       # let any seller-role user act as a synthetic demo seller
PERSIST=on                    # SQLite persistence. "off" keeps everything in memory
CROSSOVER_DB=                 # path to the SQLite file; default api/data/app.db
CORS_ORIGINS=                 # extra browser origins, comma separated (localhost and private networks are always allowed)
