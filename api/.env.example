# Server-side only. Never expose these to the browser.
OPENAI_API_KEY=
# Read model names from the team's OpenAI dashboard before the build; this list changes quickly.
MODEL_INTAKE=
MODEL_FALLBACK=
MODEL_TRANSCRIBE=
# Balanced priority mode: how far above the cheapest landed cost it will pay to arrive sooner (our assumption).
BALANCED_THRESHOLD=0.05
