# Paste your keys after the = sign. No quotes, no spaces. This file is git-ignored; never commit it.
# Restart the API after editing (python3 -m uvicorn app.main:app --port 8000, run from api/).

# --- OpenAI: text intake, seller wording, item-match, selection explainer ---
OPENAI_API_KEY=
# Cheapest current model per OpenAI's models page ($0.10 in / $0.50 out per million tokens). If the golden test
# shows invented or wrong fields, switch to gpt-6.1-sol ($2 / $10).
MODEL_INTAKE=gpt-6-luna

# --- ElevenLabs: speech-to-text for voice intake ---
ELEVENLABS_API_KEY=
# scribe_v2 is the model named in ElevenLabs' current docs.
ELEVENLABS_STT_MODEL=scribe_v2

# Balanced priority: how far above the cheapest landed cost it will pay to arrive sooner (our assumption).
BALANCED_THRESHOLD=0.05

# --- Supabase Auth ---
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
