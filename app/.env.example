# Browser-side settings. Both are public by design (the anon key is not a secret). Copy to .env.local.
# Use the same values as SUPABASE_URL and SUPABASE_ANON_KEY in api/.env. Never put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: where the API runs. Defaults to http://localhost:8000
VITE_API_URL=
